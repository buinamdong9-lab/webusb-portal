# =============================================================================
# .env.example - Cấu hình Môi trường Triển khai Hệ thống WebUSB BTL86
# Sao chép tệp này thành .env và điền các giá trị thực tế trước khi chạy
# =============================================================================

# Chế độ chạy: true (Chế độ giả lập Dev), false (Chế độ thật Production)
DEV_MODE=false

# Cổng lắng nghe của máy chủ Web API
PORT=8686

# Đường dẫn tệp khóa bí mật RSA-2048 (CHỈ NẰM TRÊN MÁY CHỦ)
RSA_PRIVATE_KEY_PATH=rsa_private.xml

# Định giá kích hoạt USB An Toàn (Mặc định 20.000 VNĐ)
PRICE_VND=20000

# Cấu hình Cổng Thanh Toán Tự Động VietQR (SePay / PayOS)
SEPAY_API_KEY=YOUR_SEPAY_API_KEY_HERE
SEPAY_ACCOUNT_NO=0779356619
SEPAY_BANK_NAME=MB
SEPAY_ACCOUNT_NAME=BUI NAM DONG

